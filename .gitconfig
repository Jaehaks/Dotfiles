[user]
	name = Jaehaks
	email = wogkr3654@naver.com
[credential]
	helper = manager
[core]
	autocrlf = true
	editor = nvim
	quotepath = false
[alias]
	lg = log --graph --oneline --decorate --all --pretty=format:'%C(auto)%h%Creset %C(auto)%d%Creset %s %C(blue)(%cr)%Creset'
[commit]
	verbose = true
[diff]
	algorithm = histogram
	indentHeuristic = true
